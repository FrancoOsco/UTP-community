---
import '../styles/app.css';
interface Props { title?: string; description?: string; }
const {title='UTP Community',description='El espacio digital para conectar, compartir y aprender con estudiantes UTP.'}=Astro.props;
---
<!doctype html><html lang="es"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="theme-color" content="#cf0839"/><meta name="description" content={description}/><link rel="icon" href="/favicon.svg"/><title>{title} | UTP Community</title><link rel="preconnect" href="https://fonts.googleapis.com"/><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/><link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet"/></head><body><slot /></body></html>
