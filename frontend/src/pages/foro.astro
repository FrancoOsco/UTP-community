---
import AppShell from '../components/AppShell.astro';import Icon from '../components/Icon.astro';
---
<AppShell active="foros" heading="Conversación académica" subheading="Un espacio para compartir lo que sabemos y aprender juntos.">
<a class="back-link" href="/foros">← Volver a los foros</a><section id="topic-detail" class="topic-detail"><div class="skeleton-card"></div></section><div class="section-header"><div><h2 id="answer-title">Respuestas</h2><p>Las buenas ideas crecen cuando las compartimos.</p></div></div><div id="answer-list" class="answer-list"></div><div class="editor-card answer-editor"><h3>Únete a la conversación</h3><p>Comparte una respuesta clara y respetuosa.</p><form id="answer-form"><textarea id="answer-text" placeholder="Escribe tu respuesta aquí..." minlength="2" maxlength="3000" rows="5" required></textarea><div class="editor-bottom"><small>Máximo 3000 caracteres.</small><button type="submit" class="btn btn-primary" id="answer-submit"><Icon name="send" size={16}/> Publicar respuesta</button></div><p id="answer-error" class="form-message"></p></form></div>
<Fragment slot="aside"><section class="aside-card"><div class="aside-title"><Icon name="heart" size={17}/> Aprendamos juntos</div><p class="aside-desc">Responde con claridad, escucha otras perspectivas y utiliza los votos para reconocer las contribuciones útiles.</p></section></Fragment>
</AppShell>
<script>
import {authFetch} from '../lib/auth';import {escapeHtml as h,fecha,categories,responseError,showToast} from '../lib/ui';
const id=new URLSearchParams(location.search).get('id');let userId:number|undefined;
document.addEventListener('utp:user',(e:Event)=>{userId=(e as CustomEvent).detail.id;});
function voteMarkup(p:any, kind:'question'|'answer'){const isOwn=p.autorId===userId;return `<div class="vote-stack"><button type="button" data-vote="1" data-kind="${kind}" data-id="${p.id}" class="vote-button ${p.miVoto===1?'voted':''}" aria-label="Voto positivo" ${isOwn?'disabled title="No puedes votar tu contenido"':''}>▲</button><b>${p.puntos}</b><button type="button" data-vote="-1" data-kind="${kind}" data-id="${p.id}" class="vote-button ${p.miVoto===-1?'voted':''}" aria-label="Voto negativo" ${isOwn?'disabled title="No puedes votar tu contenido"':''}>▼</button></div>`;}
async function load(){const detail=document.getElementById('topic-detail')!;const answers=document.getElementById('answer-list')!;if(!id||!/^\d+$/.test(id)){detail.innerHTML='<div class="empty-state">Publicación no válida.</div>';return;}try{const r=await authFetch('/api/foros/'+id);if(!r?.ok)throw new Error(r?await responseError(r):'Debes iniciar sesión.');const p=await r.json();detail.innerHTML=`<article class="topic-card"><div class="topic-votes">${voteMarkup(p,'question')}</div><div class="topic-content"><span class="category-chip">${h(categories[p.categoria])}</span><h2>${h(p.titulo)}</h2><div class="topic-byline"><span class="small-avatar">${h((p.autor||'U')[0])}</span><span><b>${h(p.autor)}</b> · ${h(fecha(p.creadoEn))}</span></div><p class="topic-text">${h(p.contenido).replace(/\n/g,'<br>')}</p><div class="discussion-foot"><span>◌ ${p.respuestas} respuestas</span><span>Para estudiantes UTP</span></div></div></article>`;document.getElementById('answer-title')!.textContent=p.respuestas+' '+(p.respuestas===1?'respuesta':'respuestas');answers.innerHTML=p.listaRespuestas.length?p.listaRespuestas.map((a:any)=>`<article class="answer-card">${voteMarkup(a,'answer')}<div class="answer-main"><div class="discussion-top"><span class="small-avatar">${h((a.autor||'U')[0])}</span><div><b>${h(a.autor)}</b><small>${h(fecha(a.creadoEn))}</small></div></div><p>${h(a.contenido).replace(/\n/g,'<br>')}</p></div></article>`).join(''):'<div class="empty-state"><p>Aún no hay respuestas. Puedes iniciar la conversación.</p></div>';bindVotes();}catch(err){detail.innerHTML='<div class="empty-state"><h3>No se pudo abrir la publicación</h3><p>'+h((err as Error).message)+'</p></div>';}}
function bindVotes(){document.querySelectorAll<HTMLButtonElement>('[data-vote]').forEach(btn=>btn.addEventListener('click',async()=>{const base=btn.dataset.kind==='question'?'/api/foros/'+id+'/votos':'/api/foros/'+id+'/respuestas/'+btn.dataset.id+'/votos';const already=btn.classList.contains('voted');try{const r=await authFetch(base,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({valor:already?0:Number(btn.dataset.vote)})});if(!r?.ok)throw new Error(r?await responseError(r):'No se pudo registrar el voto.');await load();}catch(err){showToast((err as Error).message,true);}}));}
document.getElementById('answer-form')?.addEventListener('submit',async e=>{e.preventDefault();if(!id)return;const el=document.getElementById('answer-text') as HTMLTextAreaElement;const btn=document.getElementById('answer-submit') as HTMLButtonElement;const error=document.getElementById('answer-error')!;btn.disabled=true;btn.textContent='Publicando...';error.textContent='';try{const r=await authFetch('/api/foros/'+id+'/respuestas',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({contenido:el.value.trim()})});if(!r?.ok)throw new Error(r?await responseError(r):'Necesitas iniciar sesión.');el.value='';showToast('¡Respuesta publicada!');await load();}catch(err){error.textContent=(err as Error).message;}finally{btn.disabled=false;btn.textContent='Publicar respuesta →';}});
setTimeout(load,350);
</script>
