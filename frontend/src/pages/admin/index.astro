---
import '../../styles/auth.css';
---

<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Administración</title>
  </head>

  <body>
    <main>
      <h1>Administración</h1>

      <p id="mensaje">Cargando...</p>

      <div id="usuarios" class="lista"></div>

      <button id="logout"> Cerrar sesión </button>
    </main>

    <script>
      import { authFetch, logout } from '../../lib/auth';

      interface Usuario {
        id: number;
        nombre: string;
        apellido: string;
        email: string;
        rol: string;
      }

      const mensaje = document.getElementById('mensaje') as HTMLParagraphElement;

      const usuariosDiv = document.getElementById('usuarios') as HTMLDivElement;

      const logoutButton = document.getElementById('logout');

      const response = await authFetch('/api/usuarios');

      if (!response) {
        window.location.href = '/';
      } else if (response.status === 403) {
        window.location.href = '/dashboard';
      } else if (response.ok) {
        const usuarios = (await response.json()) as Usuario[];

        mensaje.textContent = 'Sesión de administrador activa.';

        usuarios.forEach((usuario) => {
          const elemento = document.createElement('p');

          elemento.textContent = `${usuario.nombre} ${usuario.apellido}
                    - ${usuario.email}
                    - ${usuario.rol}`;

          usuariosDiv.appendChild(elemento);
        });
      } else {
        mensaje.textContent = 'No se pudo cargar la información.';
      }

      logoutButton?.addEventListener('click', async () => {
        await logout();

        window.location.href = '/';
      });
    </script>
  </body>
</html>
