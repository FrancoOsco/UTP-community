---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
---

<Layout title="Crear cuenta"
  ><main class="auth-layout">
    <section class="auth-cover">
      <a class="brand light" href="/"
        ><span class="brand-mark">UTP</span><span
          ><strong>UTP Community</strong><small>Juntos llegamos más lejos.</small></span
        ></a
      ><div class="auth-cover-middle">
        <span class="auth-cover-tag">CRECE CON TU COMUNIDAD</span><h1>
          Tu próxima gran idea comienza <em>aquí.</em>
        </h1><p>
          Comparte tus experiencias, encuentra nuevas perspectivas y conéctate con estudiantes como
          tú.
        </p><div class="auth-cover-orbit">✦ <span>✧</span> ✦</div>
      </div><small>Proyecto académico · Universidad Tecnológica del Perú</small>
    </section><section class="auth-pane">
      <div class="auth-box register-box">
        <a href="/" class="back-link">← Volver al inicio</a><span class="form-icon"
          ><Icon name="users" size={25} /></span
        ><p class="eyebrow">TU COMUNIDAD TE ESPERA</p><h2>Crea tu cuenta</h2><p class="subcopy">
          Utiliza tus datos y tu correo institucional UTP.
        </p><form id="registerForm" class="pretty-form">
          <div class="field-row">
            <div>
              <label for="nombre">Nombre</label><input
                id="nombre"
                maxlength="90"
                required
                autocomplete="given-name"
                placeholder="Tu nombre"
              />
            </div><div>
              <label for="apellido">Apellido</label><input
                id="apellido"
                maxlength="90"
                required
                autocomplete="family-name"
                placeholder="Tu apellido"
              />
            </div>
          </div><label for="email">Correo institucional</label><div class="input-wrap">
            <Icon name="mail" size={18} /><input
              id="email"
              type="email"
              placeholder="u12345678@utp.edu.pe"
              required
              autocomplete="username"
              pattern="[a-zA-Z0-9._%+\-]+@utp\.edu\.pe"
              title="Debes usar un correo @utp.edu.pe"
            />
          </div><label for="password">Contraseña</label><div class="input-wrap">
            <Icon name="lock" size={18} /><input
              id="password"
              type="password"
              minlength="8"
              required
              autocomplete="new-password"
              placeholder="Crea una contraseña segura"
            />
          </div><p class="password-hint">
            8+ caracteres, mayúscula, minúscula, número y símbolo.
          </p><button class="btn btn-primary btn-full" id="registerButton" type="submit"
            >Crear cuenta institucional <Icon name="arrow" size={17} /></button
          >
        </form><p id="mensaje" class="form-message" role="status"></p><div class="auth-switch">
          ¿Ya tienes una cuenta? <a href="/login">Inicia sesión</a>
        </div><div class="auth-privacy">
          <Icon name="shield" size={16} /> Te enviaremos un enlace para verificar tu correo.
        </div>
      </div>
    </section>
  </main>
  <script>
    import { apiFetch } from '../lib/api';
    import { responseError } from '../lib/ui';
    const el = (id: string) => document.getElementById(id) as HTMLInputElement;
    document.getElementById('registerForm')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const btn = document.getElementById('registerButton') as HTMLButtonElement;
      const msg = el('mensaje');
      btn.disabled = true;
      btn.textContent = 'Creando cuenta...';
      msg.textContent = '';
      try {
        const r = await apiFetch('/api/auth/register', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            nombre: el('nombre').value.trim(),
            apellido: el('apellido').value.trim(),
            email: el('email').value.trim().toLowerCase(),
            password: el('password').value,
          }),
        });
        if (!r.ok) throw new Error(await responseError(r));
        msg.textContent =
          'Cuenta creada. Revisa tu correo UTP y verifica tu cuenta antes de ingresar.';
        msg.classList.add('success');
        btn.textContent = 'Correo de verificación enviado';
      } catch (error) {
        msg.textContent =
          error instanceof Error ? error.message : 'No se pudo conectar con el servidor.';
        btn.textContent = 'Crear cuenta institucional →';
        btn.disabled = false;
      }
    });
  </script>
</Layout>
