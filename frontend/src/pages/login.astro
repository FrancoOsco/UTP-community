---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
---

<Layout title="Ingresar"
  ><main class="auth-layout">
    <section class="auth-cover">
      <a class="brand light" href="/"
        ><span class="brand-mark">UTP</span><span
          ><strong>UTP Community</strong><small>Juntos llegamos más lejos.</small></span
        ></a
      ><div class="auth-cover-middle">
        <span class="auth-cover-tag">TU ESPACIO, TUS PERSONAS</span><h1>
          Las mejores ideas nacen cuando <em>conectamos.</em>
        </h1><p>
          Comparte dudas, descubre recomendaciones y forma parte de una comunidad académica
          exclusiva.
        </p><div class="auth-cover-orbit">✧ <span>✦</span> ✧</div>
      </div><small>Proyecto académico · Universidad Tecnológica del Perú</small>
    </section><section class="auth-pane">
      <div class="auth-box">
        <a href="/" class="back-link">← Volver al inicio</a><span class="form-icon"
          ><Icon name="graduation" size={26} /></span
        ><p class="eyebrow">BIENVENIDO DE VUELTA</p><h2>Inicia sesión</h2><p class="subcopy">
          Entra con tu correo institucional para continuar.
        </p><form id="loginForm" class="pretty-form">
          <label for="email">Correo institucional</label><div class="input-wrap">
            <Icon name="mail" size={18} /><input
              id="email"
              type="email"
              placeholder="u12345678@utp.edu.pe"
              required
              autocomplete="username"
              pattern="[a-zA-Z0-9._%+\-]+@utp\.edu\.pe"
              title="Usa tu correo @utp.edu.pe"
            />
          </div><label for="password">Contraseña</label><div class="input-wrap">
            <Icon name="lock" size={18} /><input
              id="password"
              type="password"
              placeholder="Ingresa tu contraseña"
              required
              autocomplete="current-password"
            />
          </div><div class="form-subline">
            <span><Icon name="shield" size={15} /> Acceso institucional seguro</span><a
              href="/forgot-password">¿Olvidaste tu contraseña?</a>
          </div><button class="btn btn-primary btn-full" id="login-button" type="submit"
            >Iniciar sesión <Icon name="arrow" size={17} /></button>
        </form><p id="mensaje" class="form-message" role="alert"></p><div class="auth-switch">
          ¿Aún no tienes una cuenta? <a href="/register">Regístrate aquí</a>
        </div><div class="auth-privacy">
          <Icon name="shield" size={16} /> Solo usuarios con correo <b>@utp.edu.pe</b> verificado.
        </div>
      </div>
    </section>
  </main>
  <script>
    import { login, esAdmin } from '../lib/auth';
    const form = document.getElementById('loginForm') as HTMLFormElement;
    const email = document.getElementById('email') as HTMLInputElement;
    const password = document.getElementById('password') as HTMLInputElement;
    const msg = document.getElementById('mensaje') as HTMLElement;
    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const btn = document.getElementById('login-button') as HTMLButtonElement;
      btn.disabled = true;
      btn.textContent = 'Ingresando...';
      msg.textContent = '';
      try {
        await login(email.value.trim(), password.value);
        location.href = (await esAdmin()) ? '/admin' : '/dashboard';
      } catch (err) {
        msg.textContent = err instanceof Error ? err.message : 'No se pudo iniciar sesión.';
        btn.disabled = false;
        btn.textContent = 'Iniciar sesión →';
      }
    });
  </script>
</Layout>
