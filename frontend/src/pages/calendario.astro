---
import AppShell from '../components/AppShell.astro';
---
<AppShell active="calendario" heading="Mi calendario" subheading="Organiza tus exámenes, exposiciones y entregas." wide>
<div class="academic-toolbar"><button class="btn btn-outline" id="prev-month" aria-label="Mes anterior">‹</button><h2 id="month" style="margin:0;flex:1"></h2><button class="btn btn-outline" id="next-month" aria-label="Mes siguiente">›</button><button class="btn btn-outline" id="today">Hoy</button><button class="btn btn-primary" id="new">+ Nueva actividad</button></div><p class="academic-muted">Doble clic en un día para añadir una actividad. Clic en una actividad para ver sus detalles.</p><label class="academic-check academic-muted"><input type="checkbox" id="meetings"> Mostrar reuniones académicas aceptadas</label><div class="calendar-scroll"><div class="calendar-month" id="calendar"></div></div>
<div id="event-pop" class="academic-card calendar-popover" hidden></div>
<dialog id="event-dialog" class="academic-dialog"><h2 id="event-heading">Nueva actividad</h2><form id="event-form" class="academic-form"><label>Fecha<input id="event-day" type="date" required/></label><label>Tipo de actividad<select id="event-kind"><option>Examen</option><option>Exposición</option><option>Recuperación</option><option>Entrega de proyecto</option><option>Importante</option></select></label><label>Nombre del curso<input id="event-course" maxlength="200" required/></label><label>Descripción (opcional)<textarea id="event-desc" maxlength="2000" rows="3"></textarea></label><label>Color</label><div id="palette" class="palette"></div><div class="calendar-event" id="preview"><strong id="preview-kind"></strong><div class="event-course"><span id="preview-course"></span></div></div><div id="event-error" class="academic-error"></div><div class="academic-actions"><button type="button" class="btn btn-outline" id="close-event">Cancelar</button><button class="btn btn-primary" id="save-event">Guardar</button></div></form></dialog>
</AppShell>
<script>
import {$,data,val,esc,json,error,dateKey} from '../lib/academic';
const colors=['#f4b9bc','#f5c8df','#f8d0b4','#f7e2ab','#dce8b4','#c0e4d1','#b9e2e2','#c5d9f5','#dcd0f5','#d9dce2'];const labels=['Rojo','Rosa','Naranja','Amarillo','Verde','Menta','Turquesa','Azul','Lavanda','Gris'];let month=new Date();month.setDate(1);let events:any[]=[],meetings:any[]=[],activeId:number|null=null,color=colors[0],generation=0;const dlg=$('event-dialog') as HTMLDialogElement;const pop=$('event-pop');
function preview(){ $('preview').style.background=color;$('preview-kind').textContent=val('event-kind');$('preview-course').textContent=val('event-course')||'Nombre del curso';$('palette').querySelectorAll('button').forEach((b,i)=>{b.setAttribute('aria-pressed',String(colors[i]===color));b.textContent=colors[i]===color?'✓':'';});}
$('palette').innerHTML=colors.map((c,i)=>`<button type="button" style="background:${c}" aria-label="${labels[i]}" title="${labels[i]}"></button>`).join('');$('palette').querySelectorAll('button').forEach((b,i)=>b.onclick=()=>{color=colors[i];preview();});$('event-kind').addEventListener('change',preview);$('event-course').addEventListener('input',preview);
function open(day:string,e?:any){pop.hidden=true;activeId=e?.id??null;$('event-heading').textContent=e?'Editar actividad':'Nueva actividad';($('event-day') as HTMLInputElement).value=day;($('event-kind') as HTMLSelectElement).value=e?.kind||'Examen';($('event-course') as HTMLInputElement).value=e?.course||'';($('event-desc') as HTMLTextAreaElement).value=e?.description||'';color=e?.color||colors[0];$('event-error').textContent='';preview();dlg.showModal();}
function details(day:string,anchor:HTMLElement,only?:number){const rows=events.filter(e=>String(e.day).slice(0,10)===day&&(only===undefined||e.id===only));pop.innerHTML=`<h3>${esc(day)}</h3>${rows.map(e=>`<div class="academic-file"><div class="file-main"><b>${esc(e.kind)} · ${esc(e.course)}</b><p class="academic-description">${esc(e.description||'Sin descripción')}</p><div class="academic-actions"><button class="btn btn-outline" data-edit="${e.id}">Editar</button><button class="btn btn-outline" data-delete="${e.id}">Eliminar</button></div></div></div>`).join('')}<button class="btn btn-primary" id="pop-add">+ Añadir actividad</button>`;pop.hidden=false;const rect=anchor.getBoundingClientRect();pop.style.left=Math.max(8,Math.min(rect.left,innerWidth-pop.offsetWidth-8))+'px';pop.style.top=Math.max(8,Math.min(rect.bottom+5,innerHeight-pop.offsetHeight-8))+'px';pop.querySelectorAll<HTMLButtonElement>('[data-edit]').forEach(b=>b.onclick=()=>open(day,events.find(e=>e.id===Number(b.dataset.edit))));pop.querySelectorAll<HTMLButtonElement>('[data-delete]').forEach(b=>b.onclick=async()=>{if(confirm('¿Eliminar actividad?'))try{await data('/api/calendario/'+b.dataset.delete,{method:'DELETE'});pop.hidden=true;await load();}catch(e){error(e);}});$('pop-add').onclick=()=>open(day);}
function paint(){const first=new Date(month.getFullYear(),month.getMonth(),1),start=new Date(first);start.setDate(1-(first.getDay()+6)%7);const count=Math.ceil(((first.getDay()+6)%7+new Date(first.getFullYear(),first.getMonth()+1,0).getDate())/7)*7;$('month').textContent=first.toLocaleDateString('es-PE',{month:'long',year:'numeric'});const today=dateKey(new Date());$('calendar').innerHTML=['Lun','Mar','Mié','Jue','Vie','Sáb','Dom'].map(d=>`<div class="calendar-weekday">${d}</div>`).join('')+Array.from({length:count},(_,i)=>{const d=new Date(start);d.setDate(start.getDate()+i);const key=dateKey(d);const es=events.filter(e=>String(e.day).slice(0,10)===key);const ms=meetings.filter(m=>dateKey(new Date(m.starts))===key);return `<div class="calendar-day ${d.getMonth()!==month.getMonth()?'other':''} ${key===today?'today':''}" data-day="${key}"><div class="calendar-date"><span>${d.getDate()}</span><button aria-label="Añadir actividad" data-add>+</button></div>${es.slice(0,2).map(e=>`<button class="calendar-event" data-event="${e.id}" style="background:${colors.includes(e.color)?e.color:colors[0]}"><strong>${esc(e.kind)}</strong><div class="event-course"><span>${esc(e.course)}</span></div></button>`).join('')}${es.length>2?`<button class="calendar-more" data-more>+${es.length-2} actividades más</button>`:''}${ms.map(m=>`<a class="calendar-more" href="/reuniones?id=${m.id}">◉ ${esc(m.title)}</a>`).join('')}</div>`;}).join('');$('calendar').querySelectorAll<HTMLElement>('[data-day]').forEach(cell=>{const day=cell.dataset.day!;cell.ondblclick=e=>{if(!(e.target as HTMLElement).closest('button,a'))open(day);};cell.querySelector<HTMLButtonElement>('[data-add]')!.onclick=()=>open(day);cell.querySelectorAll<HTMLButtonElement>('[data-event]').forEach(b=>b.onclick=()=>details(day,b,Number(b.dataset.event)));const more=cell.querySelector<HTMLButtonElement>('[data-more]');if(more)more.onclick=()=>details(day,more);});}
async function load(){const g=++generation;pop.hidden=true;try{const es=await data(`/api/calendario?mes=${month.getMonth()+1}&anio=${month.getFullYear()}`);const ms=($('meetings') as HTMLInputElement).checked?await data('/api/reuniones'):[];if(g!==generation)return;events=es;meetings=ms.filter((m:any)=>m.mine||m.invitation_status==='ACCEPTED');paint();}catch(e){error(e);}}
$('prev-month').onclick=()=>{month.setMonth(month.getMonth()-1);void load();};$('next-month').onclick=()=>{month.setMonth(month.getMonth()+1);void load();};$('today').onclick=()=>{month=new Date();month.setDate(1);void load();};$('new').onclick=()=>open(dateKey(new Date()));$('meetings').onchange=()=>void load();$('close-event').onclick=()=>dlg.close();document.addEventListener('click',e=>{if(!(e.target as HTMLElement).closest('#event-pop,[data-event],[data-more]'))pop.hidden=true;});document.addEventListener('keydown',e=>{if(e.key==='Escape')pop.hidden=true;});$('event-form').onsubmit=async e=>{e.preventDefault();const btn=$('save-event') as HTMLButtonElement;btn.disabled=true;try{const day=val('event-day');await data('/api/calendario'+(activeId?'/'+activeId:''),json(activeId?'PUT':'POST',{day,kind:val('event-kind'),course:val('event-course'),description:val('event-desc'),color}));month=new Date(day+'T12:00:00');month.setDate(1);dlg.close();await load();}catch(e){$('event-error').textContent=(e as Error).message;}finally{btn.disabled=false;}};void load();
</script>
