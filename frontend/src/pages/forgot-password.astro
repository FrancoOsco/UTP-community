---
import '../styles/auth.css';
---

<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Recuperar contraseña</title>
  </head>

  <body>
    <main>
      <h1>Auth Template</h1>
      <h2>Recuperar contraseña</h2>

      <form id="forgotForm">
        <div>
          <label for="email">Correo</label>
          <input id="email" type="email" required />
        </div>

        <button id="forgotButton" type="submit"> Enviar enlace </button>
      </form>

      <p id="mensaje"></p>

      <nav>
        <a href="/">Volver</a>
      </nav>
    </main>

    <script>
      import { apiFetch } from '../lib/api';

      const form = document.getElementById('forgotForm');

      const email = document.getElementById('email') as HTMLInputElement;

      const mensaje = document.getElementById('mensaje') as HTMLParagraphElement;

      const boton = document.getElementById('forgotButton') as HTMLButtonElement;

      form?.addEventListener('submit', async (event) => {
        event.preventDefault();

        boton.disabled = true;
        boton.classList.add('loading');
        boton.classList.remove('completed');
        boton.textContent = 'Enviando...';

        mensaje.textContent = '';

        try {
          const response = await apiFetch('/api/auth/forgot-password', {
            method: 'POST',

            headers: {
              'Content-Type': 'application/json',
            },

            body: JSON.stringify({
              email: email.value,
            }),
          });

          const data = await response.json();

          mensaje.textContent = data.mensaje ?? data.message ?? 'Solicitud procesada.';

          if (response.ok) {
            boton.classList.remove('loading');
            boton.classList.add('completed');
            boton.textContent = 'Enlace enviado';
          } else {
            boton.disabled = false;
            boton.classList.remove('loading');
            boton.textContent = 'Enviar enlace';
          }
        } catch {
          mensaje.textContent = 'No se pudo conectar con el servidor.';

          boton.disabled = false;
          boton.classList.remove('loading');
          boton.textContent = 'Enviar enlace';
        }
      });
    </script>
  </body>
</html>
