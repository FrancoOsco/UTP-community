---
import AppShell from '../components/AppShell.astro';
import Icon from '../components/Icon.astro';
---

<AppShell
  active="perfil"
  heading="Mi perfil"
  subheading="Tu espacio personal dentro de la comunidad UTP."
>
  <div class="profile-banner"><div class="profile-banner-pattern"></div></div><section
    class="profile-card"
  >
    <div class="profile-card-top">
      <div class="profile-avatar" id="profile-avatar">U</div><div class="profile-info">
        <div class="profile-name-row">
          <h2 id="profile-name">Estudiante UTP</h2><span class="profile-verified"
            ><Icon name="check" size={15} /> Verificado</span
          >
        </div><p id="profile-career">Comunidad académica · Universidad Tecnológica del Perú</p><span
          class="profile-campus"
          ><Icon name="mail" size={14} /> <span id="profile-email">Cargando...</span></span
        >
      </div><button id="profile-edit-toggle" class="btn btn-outline"
        ><Icon name="edit" size={16} /> Editar perfil</button
      >
    </div><p class="profile-bio" id="profile-bio">
      Conectando con nuestra comunidad académica.
    </p><div class="profile-stats">
      <div><strong id="profile-posts">–</strong><span>Publicaciones</span></div><div>
        <strong id="profile-answers">–</strong><span>Respuestas</span>
      </div><div><strong><Icon name="shield" size={23} /></strong><span>Identidad UTP</span></div>
    </div>
  </section>
  <section id="profile-edit" class="editor-card profile-edit" hidden>
    <div class="editor-heading">
      <div class="editor-symbol"><Icon name="edit" size={22} /></div><div>
        <h2>Editar mi información</h2><p>
          Comparte lo que te gustaría que otros estudiantes sepan sobre ti.
        </p>
      </div>
    </div><form id="profile-form" class="editor-form">
      <div class="field-row">
        <div>
          <label for="p-nombre">Nombre</label><input id="p-nombre" required maxlength="90" />
        </div><div>
          <label for="p-apellido">Apellido</label><input id="p-apellido" required maxlength="90" />
        </div>
      </div><div class="field-row">
        <div>
          <label for="p-carrera">Carrera</label><input
            id="p-carrera"
            maxlength="100"
            placeholder="Ej.: Ingeniería de Sistemas"
          />
        </div><div>
          <label for="p-ciclo">Ciclo</label><input
            id="p-ciclo"
            type="number"
            min="1"
            max="14"
            placeholder="Ej.: 8"
          />
        </div>
      </div><label for="p-bio">Acerca de mí</label><textarea
        id="p-bio"
        rows="4"
        maxlength="500"
        placeholder="Cuéntanos qué temas te interesan..."></textarea><div class="editor-bottom">
        <button type="button" class="btn btn-outline" id="cancel-edit">Cancelar</button><button
          type="submit"
          class="btn btn-primary"
          id="save-profile">Guardar cambios</button
        >
      </div><p id="profile-error" class="form-message"></p>
    </form>
  </section>
  <div class="section-header">
    <div>
      <h2>Mi vida universitaria</h2><p>Un resumen de tu actividad académica en esta plataforma</p>
    </div>
  </div><div class="profile-links">
    <a href="/foros" class="profile-action"
      ><span class="shortcut-icon s-red"><Icon name="forum" size={22} /></span><div>
        <b>Mis conversaciones y respuestas</b><p>
          Explora las publicaciones en las que puedes participar.
        </p>
      </div><Icon name="chevron" size={17} /></a
    ><a href="/foros/nuevo" class="profile-action"
      ><span class="shortcut-icon s-purple"><Icon name="edit" size={22} /></span><div>
        <b>Compartir una nueva idea</b><p>Publica tus preguntas o consejos académicos.</p>
      </div><Icon name="chevron" size={17} /></a
    >
  </div>
  <Fragment slot="aside"
    ><section class="aside-card">
      <div class="aside-title"><Icon name="shield" size={18} /> Cuenta institucional</div><p
        class="aside-desc"
      >
        Tu perfil está asociado a tu correo UTP verificado, que no se puede cambiar desde esta
        sección.
      </p><div class="secure-tag"><span class="online-dot"></span> Cuenta verificada</div>
    </section></Fragment
  >
</AppShell>
<script>
  import { authFetch } from '../lib/auth';
  import { responseError, showToast } from '../lib/ui';
  const el = (id: string) => document.getElementById(id)!;
  let user: any = null;
  function paint(u: any) {
    user = u;
    el('profile-name').textContent = u.nombre + ' ' + u.apellido;
    el('profile-avatar').textContent = (u.nombre[0] ?? 'U') + (u.apellido[0] ?? '');
    el('profile-email').textContent = u.email;
    el('profile-career').textContent =
      (u.carrera || 'Estudiante UTP') + (u.ciclo ? ' · ' + u.ciclo + '° ciclo' : '');
    el('profile-bio').textContent =
      u.biografia || 'Este espacio es para compartir intereses y proyectos académicos.';
    el('profile-posts').textContent = u.publicaciones;
    el('profile-answers').textContent = u.respuestas;
  }
  document.addEventListener('utp:user', (e: Event) => paint((e as CustomEvent).detail));
  function toggle(show: boolean) {
    el('profile-edit').hidden = !show;
    if (show && user) {
      (el('p-nombre') as HTMLInputElement).value = user.nombre;
      (el('p-apellido') as HTMLInputElement).value = user.apellido;
      (el('p-carrera') as HTMLInputElement).value = user.carrera ?? '';
      (el('p-ciclo') as HTMLInputElement).value = user.ciclo ?? '';
      (el('p-bio') as HTMLTextAreaElement).value = user.biografia ?? '';
      el('profile-edit').scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
  }
  el('profile-edit-toggle').addEventListener('click', () => toggle(true));
  el('cancel-edit').addEventListener('click', () => toggle(false));
  el('profile-form').addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = el('save-profile') as HTMLButtonElement;
    btn.disabled = true;
    el('profile-error').textContent = '';
    try {
      const ciclo = (el('p-ciclo') as HTMLInputElement).value;
      const r = await authFetch('/api/me', {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          nombre: (el('p-nombre') as HTMLInputElement).value.trim(),
          apellido: (el('p-apellido') as HTMLInputElement).value.trim(),
          carrera: (el('p-carrera') as HTMLInputElement).value.trim(),
          ciclo: ciclo ? Number(ciclo) : null,
          biografia: (el('p-bio') as HTMLTextAreaElement).value.trim(),
        }),
      });
      if (!r?.ok) throw new Error(r ? await responseError(r) : 'Sesión expirada');
      paint(await r.json());
      el('nav-nombre')!.textContent = user.nombre + ' ' + user.apellido;
      toggle(false);
      showToast('Tu perfil se guardó correctamente.');
    } catch (err) {
      el('profile-error').textContent = (err as Error).message;
    } finally {
      btn.disabled = false;
    }
  });
</script>
