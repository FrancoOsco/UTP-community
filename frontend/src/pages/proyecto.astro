---
import AppShell from '../components/AppShell.astro';
---
<AppShell active="proyectos" heading="Proyecto académico" subheading="Conocimiento compartido por la comunidad UTP." wide>
<a href="/proyectos" class="academic-link">← Volver al repositorio</a><div class="academic-detail" id="detail"></div>
<section class="academic-card" id="editor" hidden><h2 id="form-title">Publicar proyecto</h2><form id="project-form" class="academic-form">
<label>Título<input name="title" required maxlength="200"/></label><div class="field-row"><label>Carrera<input name="career" required maxlength="150"/></label><label>Curso<input name="course" required maxlength="150"/></label></div><label>Tipo de proyecto<select name="kind"><option>Investigación</option><option>Software</option><option>Diseño</option><option>Inteligencia de negocios</option><option>Modelamiento de procesos</option><option>Proyecto empresarial</option><option>Audiovisual</option><option>Otro</option></select></label><label>Descripción<textarea name="description" required maxlength="8000" rows="5"></textarea></label><label>Integrantes (opcional)<input name="members" maxlength="1000"/></label><label>Etiquetas (separadas por comas)<input name="tags" maxlength="500" placeholder="Investigación, diseño, Java…"/></label><label>Enlaces externos HTTPS (uno por línea)<textarea name="links" maxlength="12000" rows="3" placeholder="https://github.com/… o enlace a documentación"></textarea></label><label>Requisitos técnicos (opcional, IDs y versiones)<input name="requirements" maxlength="2000" placeholder="java21@21, node22@22, pnpm, docker"/></label><div id="req-catalog" class="academic-muted"></div><label>Archivos del proyecto (hasta 100 MB cada uno)<input type="file" multiple id="files"/></label><label>Archivo principal de los nuevos adjuntos<select id="main-new"><option value="">Automático</option></select></label><label>Portada opcional<input id="cover" type="file" accept="image/png,image/jpeg,image/webp"/></label><p class="academic-muted">Máximo 500 MB por proyecto. No publiques credenciales, información privada ni materiales sin permiso.</p><div class="academic-error" id="form-error" role="alert"></div><div class="academic-actions"><button type="button" id="cancel" class="btn btn-outline">Cancelar</button><button id="save" class="btn btn-primary">Guardar proyecto</button></div></form></section>
</AppShell>
<script>
import {$,data,request,download,json,esc,error,bytes,extension,safeUrl,gitUrl,fillCovers} from '../lib/academic';import {filePath,cover,theme,type Project,type FileItem} from '../lib/projects';import {getTools,recommend,renderTools,setup,type Tool} from '../lib/tools';
const params=new URLSearchParams(location.search);let p:Project|null=null,tools:Tool[]=[];const form=$('project-form') as HTMLFormElement;const files=$('files') as HTMLInputElement;const coverInput=$('cover') as HTMLInputElement;const detail=$('detail');
const input=(n:string)=>form.elements.namedItem(n) as HTMLInputElement;const endpoint=()=>'/api/proyectos/'+p!.id;
function editor(){detail.hidden=true;$('editor').hidden=false;$('form-title').textContent=p?'Editar proyecto':'Publicar proyecto';for(const k of ['title','description','career','course','kind','members','tags','links','requirements'])if(p)input(k).value=String((p as any)[k]??'');}
function fileRow(f:FileItem){return `<div class="academic-file"><span class="file-icon">${esc(extension(f.name).toUpperCase())}</span><div class="file-main"><b>${esc(f.name)}</b><small>${bytes(f.bytes)}${f.is_main?' · Archivo principal':''}${f.is_cover?' · Portada':''}</small></div><button class="btn btn-outline" data-get="${f.id}">↓</button>${p!.mine?`<div class="academic-actions">${!f.is_main&&!f.is_cover?`<button class="btn btn-outline" data-main="${f.id}">Principal</button>`:''}<button class="btn btn-outline" data-replace="${f.id}">Reemplazar</button><button class="btn btn-outline" data-remove="${f.id}">Eliminar</button></div>`:''}</div>`;}
function paint(){if(!p)return;detail.hidden=false;$('editor').hidden=true;const x=p;const git=x.links.split(/\r?\n/).map(gitUrl).find(Boolean);const source=x.files.find(f=>!f.is_cover&&extension(f.name)==='zip');const software=x.kind==='Software'||!!git;const recommended=recommend(tools,x.files,x.requirements+(git?',git,vscode':''));detail.innerHTML=`<div class="project-cover academic-cover-detail" style="${theme(x)}"><strong>▤</strong><small>${esc(x.course)}</small>${cover(x)}</div><section class="academic-card"><h2>${esc(x.title)}</h2><p class="academic-muted">${esc(x.career)} · ${esc(x.course)} · ${esc(x.kind)}</p><a class="academic-link" href="/estudiante?id=${x.owner_id}">◉ ${esc(x.author)} · Ver perfil →</a><p>${x.tags.split(',').filter(t=>t.trim()).map(t=>`<span class="academic-tag">${esc(t)}</span>`).join('')}</p><h3>Descripción</h3><div class="academic-description">${esc(x.description)}</div>${x.members?`<p><b>Integrantes:</b> ${esc(x.members)}</p>`:''}${x.mine?'<div class="academic-actions"><button id="edit-project" class="btn btn-outline">Editar proyecto</button><button id="delete-project" class="btn btn-outline">Eliminar proyecto</button></div>':''}</section><section class="academic-card"><h2>Archivos del proyecto</h2>${x.files.filter(f=>!f.is_cover||x.mine).map(fileRow).join('')||'<p class="academic-muted">Sin archivos adjuntos.</p>'}${x.files.some(f=>!f.is_cover)?'<button class="btn btn-primary btn-full" id="zip">↓ Descargar proyecto completo (ZIP)</button>':''}</section>${x.links?`<section class="academic-card"><h2>Enlaces externos</h2>${x.links.split(/\r?\n/).filter(s=>safeUrl(s)).map(s=>`<p><a class="academic-link" href="${esc(safeUrl(s))}" target="_blank" rel="noopener noreferrer">${esc(s)} ↗</a></p>`).join('')}</section>`:''}${software?`<section class="academic-card"><h2>Código fuente y editores</h2><p class="academic-muted">GitHub es opcional. Los proyectos descargados no se ejecutan automáticamente. Revisa el código antes de confiar en el espacio de trabajo.</p><div class="academic-actions">${git?`<a class="btn btn-primary" href="${esc('vscode://vscode.git/clone?url='+encodeURIComponent(git))}">Abrir en VS Code</a><a class="btn btn-outline" target="_blank" rel="noopener noreferrer" href="${esc(git)}">Ver en GitHub</a>`:''}${source?`<button id="source-zip" class="btn btn-outline">Descargar código fuente</button>`:''}<button id="editor-helper" class="btn btn-outline">Asistente para VS Code / IntelliJ</button></div><p class="academic-muted">Si falta el editor, utiliza el asistente de herramientas. Para ZIP, extrae el código y elige la carpeta local en el asistente.</p></section>`:''}<section class="academic-card"><h2>Herramientas recomendadas</h2><p class="academic-muted">Sugeridas por formatos y requisitos declarados. No se garantiza compatibilidad de todas las versiones.</p>${x.requirements?`<p><b>Requisitos:</b> ${esc(x.requirements)}</p>`:''}<div id="recommended"></div><div class="academic-actions"><button class="btn btn-primary" id="prepare">Preparar mi computadora (BAT)</button><a class="btn btn-outline" href="/herramientas">Catálogo completo</a></div></section>`;
renderTools($('recommended'),recommended,true);$('prepare').addEventListener('click',()=>setup($('recommended')).catch(error));void fillCovers(detail);
const handle=(selector:string,key:string,fn:(id:number)=>Promise<void>)=>detail.querySelectorAll<HTMLButtonElement>(selector).forEach(b=>b.addEventListener('click',async()=>{b.disabled=true;try{await fn(Number(b.dataset[key]));}catch(e){error(e);}finally{b.disabled=false;}}));
handle('[data-get]','get',async id=>{const f=x.files.find(f=>f.id===id)!;await download(filePath(x,f),f.name);});handle('[data-main]','main',async id=>{p=await data(endpoint()+'/archivo-principal/'+id,{method:'PUT'});paint();});handle('[data-remove]','remove',async id=>{if(confirm('¿Eliminar este archivo?')){p=await data(endpoint()+'/archivos/'+id,{method:'DELETE'});paint();}});handle('[data-replace]','replace',async id=>{const chooser=document.createElement('input');chooser.type='file';chooser.onchange=async()=>{if(!chooser.files?.[0])return;try{const fd=new FormData();fd.append('file',chooser.files[0]);p=await data(endpoint()+'/archivos/'+id,{method:'PUT',body:fd});paint();}catch(e){error(e);}};chooser.click();});
$('zip')?.addEventListener('click',()=>download(endpoint()+'/descargar-zip',`proyecto-${x.id}.zip`).catch(error));$('source-zip')?.addEventListener('click',()=>download(filePath(x,source!),source!.name).catch(error));$('edit-project')?.addEventListener('click',editor);$('delete-project')?.addEventListener('click',async()=>{if(confirm('¿Eliminar el proyecto y sus archivos?'))try{await request(endpoint(),{method:'DELETE'});location.href='/proyectos';}catch(e){error(e);}});$('editor-helper')?.addEventListener('click',()=>download('/api/herramientas/editor','Abrir-proyecto-UTP.bat',json('POST',{url:git||''})).catch(error));}
files.addEventListener('change',()=>{$('main-new').innerHTML='<option value="">Automático</option>'+Array.from(files.files||[]).map((f,i)=>`<option value="${i}">${esc(f.name)}</option>`).join('');});$('cancel').addEventListener('click',()=>p?paint():location.assign('/proyectos'));
form.addEventListener('submit',async e=>{e.preventDefault();const b=$('save') as HTMLButtonElement;b.disabled=true;$('form-error').textContent='';try{const payload=Object.fromEntries(new FormData(form));const selected=Array.from(files.files||[]);let primary=($('main-new') as HTMLSelectElement).value;const wasNew=!p;if(wasNew&&!primary){const preferred:Record<string,string[]>={Software:['zip','java','py','js'],Investigación:['pdf','docx'],Diseño:['dwg','rvt','skp','psd','pdf'],'Inteligencia de negocios':['pbix','xlsx'],'Modelamiento de procesos':['bpm','bpmn'],'Proyecto empresarial':['pdf','docx','xlsx'],Audiovisual:['mp4','wav','mp3']};const exts=preferred[String(payload.kind)]||['pdf','zip'];for(const ext of exts){const found=selected.findIndex(f=>extension(f.name)===ext);if(found>=0){primary=String(found);break;}}}p=await data(wasNew?'/api/proyectos':endpoint(),json(wasNew?'POST':'PUT',payload));for(let i=0;i<selected.length;i++){const f=selected[i];const fd=new FormData();fd.append('file',f);const before=new Set(p!.files.map(x=>x.id));p=await data(endpoint()+'/archivos',{method:'POST',body:fd});const newFile=p!.files.find(x=>!before.has(x.id));if(primary===String(i)&&newFile)p=await data(endpoint()+'/archivo-principal/'+newFile.id,{method:'PUT'});}if(coverInput.files?.[0]){const fd=new FormData();fd.append('file',coverInput.files[0]);fd.append('cover','true');p=await data(endpoint()+'/archivos',{method:'POST',body:fd});}files.value='';coverInput.value='';history.replaceState(null,'','/proyecto?id='+p!.id);paint();}catch(e){$('form-error').textContent=(e as Error).message+(p?' · Los cambios ya guardados se conservan. Revisa los adjuntos antes de volver a subirlos.':'');if(p){history.replaceState(null,'','/proyecto?id='+p.id);}}finally{b.disabled=false;}});
(async()=>{try{tools=await getTools();$('req-catalog').textContent='IDs disponibles: '+tools.map(t=>t.id).join(', ');if(params.has('new')){try{const me=await data('/api/me');input('career').value=me.carrera||'';}catch{}editor();}else{const id=Number(params.get('id'));if(!id)throw new Error('Proyecto no encontrado');p=await data('/api/proyectos/'+id);paint();}}catch(e){error(e);detail.textContent='No fue posible cargar el proyecto.';}})();
</script>
