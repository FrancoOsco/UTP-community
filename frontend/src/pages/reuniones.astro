---
import AppShell from '../components/AppShell.astro';
---
<AppShell active="reuniones" heading="Reuniones académicas" subheading="Organiza, comparte y colabora con tus compañeros." wide><div class="academic-toolbar"><button class="btn btn-primary" id="new-meeting">+ Nueva reunión</button><a href="/calendario" class="btn btn-outline">Mi calendario</a><input id="meeting-search" type="search" placeholder="Buscar reuniones o cursos…"/></div><div class="academic-pills" id="tabs"><button data-tab="upcoming" class="active">Próximas</button><button data-tab="mine">Mis reuniones</button><button data-tab="invited">Invitaciones <span id="pending-count"></span></button><button data-tab="public">Comunidad</button><button data-tab="past">Historial</button></div><div class="meeting-grid" id="meetings" style="margin-top:16px"></div>
<dialog id="meeting-dialog" class="academic-dialog"><h2 id="meeting-heading">Nueva reunión</h2><form id="meeting-form" class="academic-form"><label>Título<input id="meeting-title" required maxlength="200"/></label><label>Curso<input id="meeting-course" required maxlength="200"/></label><label>Plataforma<select id="platform"><option value="MEET">Google Meet</option><option value="ZOOM">Zoom</option></select></label><a href="https://meet.google.com/" target="_blank" rel="noopener noreferrer" class="academic-link" id="create-link">Crear enlace en Google Meet ↗</a><label>Enlace de la reunión<input id="meeting-url" required type="url" placeholder="https://meet.google.com/…"/></label><label>Inicio<input type="datetime-local" id="starts" required/></label><label>Fin<input type="datetime-local" id="ends" required/></label><label>Privacidad<select id="privacy"><option value="private">Privada · Solo invitados</option><option value="public">Comunidad UTP · Estudiantes autenticados</option></select></label><label>Invitar estudiantes<input type="search" id="student-search" placeholder="Nombre o correo institucional"/></label><div id="student-results" class="invite-list"></div><div id="selected-students" class="academic-actions"></div><label>Descripción (opcional)<textarea id="meeting-description" maxlength="2000" rows="3"></textarea></label><p class="academic-error" id="meeting-error"></p><div class="academic-actions"><button type="button" class="btn btn-outline" id="cancel-meeting">Cancelar</button><button class="btn btn-primary" id="save-meeting">Guardar</button></div></form></dialog></AppShell>
<script>
import {$,data,val,esc,json,error,safeUrl,dateKey} from '../lib/academic';import {showToast} from '../lib/ui';
let rows:any[]=[],tab=new URLSearchParams(location.search).has('invitaciones')?'invited':'upcoming',current:any=null,selected:any[]=[],timer:number,seq=0;const dlg=$('meeting-dialog') as HTMLDialogElement;const set=(id:string,v:string)=>($(id) as HTMLInputElement).value=v;const local=(d:Date)=>dateKey(d)+'T'+String(d.getHours()).padStart(2,'0')+':'+String(d.getMinutes()).padStart(2,'0');const label=(s:string)=>({PENDING:'Pendiente',ACCEPTED:'Aceptada',REJECTED:'Rechazada'} as any)[s]||s;const fmt=(v:string)=>new Date(v).toLocaleString('es-PE',{dateStyle:'medium',timeStyle:'short'});
function students(){ $('selected-students').innerHTML=selected.map(s=>`<button type="button" class="btn btn-outline" data-uninvite="${s.id}">${esc(s.name)} ×</button>`).join('');$('selected-students').querySelectorAll<HTMLButtonElement>('button').forEach(b=>b.onclick=()=>{selected=selected.filter(s=>s.id!==Number(b.dataset.uninvite));students();});}
function platform(){const meet=val('platform')==='MEET';const link=$('create-link') as HTMLAnchorElement;link.href=meet?'https://meet.google.com/':'https://zoom.us/';link.textContent='Crear enlace en '+(meet?'Google Meet':'Zoom')+' ↗';}
function open(m?:any){current=m||null;$('meeting-heading').textContent=m?'Editar reunión':'Nueva reunión';set('meeting-title',m?.title||'');set('meeting-course',m?.course||'');set('platform',m?.platform||'MEET');set('meeting-url',m?.url||'');set('starts',local(m?new Date(m.starts):new Date(Date.now()+3600000)));set('ends',local(m?new Date(m.ends):new Date(Date.now()+7200000)));set('privacy',m?.is_public?'public':'private');set('meeting-description',m?.description||'');set('student-search','');$('student-results').innerHTML='';$('meeting-error').textContent='';selected=m?.participants?.map((x:any)=>({id:x.id,name:x.name}))||[];students();platform();dlg.showModal();}
function ics(m:any){const escape=(s:string)=>String(s||'').replace(/\\/g,'\\\\').replace(/\r?\n/g,'\\n').replace(/,/g,'\\,').replace(/;/g,'\\;');const stamp=(s:string)=>new Date(s).toISOString().replace(/[-:]/g,'').replace(/\.\d+Z/,'Z');const text=['BEGIN:VCALENDAR','VERSION:2.0','PRODID:-//UTP Community//Reuniones//ES','BEGIN:VEVENT',`UID:utp-${m.id}@community`,`DTSTAMP:${stamp(new Date().toISOString())}`,`DTSTART:${stamp(m.starts)}`,`DTEND:${stamp(m.ends)}`,`SUMMARY:${escape(m.title)}`,`DESCRIPTION:${escape(m.description+(m.url?'\n'+m.url:''))}`,'END:VEVENT','END:VCALENDAR',''].join('\r\n');const u=URL.createObjectURL(new Blob([text],{type:'text/calendar;charset=utf-8'}));const a=document.createElement('a');a.href=u;a.download='reunion-'+m.id+'.ics';a.click();setTimeout(()=>URL.revokeObjectURL(u),1000);}
function paint(){const now=Date.now();$('pending-count').textContent='('+rows.filter(m=>m.invitation_status==='PENDING').length+')';$('tabs').querySelectorAll<HTMLButtonElement>('button').forEach(b=>b.classList.toggle('active',b.dataset.tab===tab));const q=val('meeting-search').toLowerCase();const list=rows.filter(m=>(tab==='mine'?m.mine:tab==='invited'?!!m.invitation_status:tab==='public'?m.is_public:tab==='past'?new Date(m.ends).getTime()<now:new Date(m.ends).getTime()>=now&&m.invitation_status!=='REJECTED')&&[m.title,m.course,m.organizer].join(' ').toLowerCase().includes(q));$('meetings').innerHTML=list.length?list.map(m=>`<article class="academic-card" data-meeting="${m.id}"><div class="meeting-head"><div><span class="academic-status">${m.platform==='MEET'?'Google Meet':'Zoom'} · ${m.is_public?'Comunidad UTP':'Privada'}</span><h3>${esc(m.title)}</h3><p class="academic-muted">${esc(m.course)} · ${esc(m.organizer)} ${m.mine?'(tú)':''}</p></div><span class="academic-tag">${m.mine?'Organizador':m.invitation_status?label(m.invitation_status):'Pública'}</span></div><p>🗓 ${esc(fmt(m.starts))} — ${esc(fmt(m.ends))}</p>${m.description?`<p class="academic-description">${esc(m.description)}</p>`:''}${m.mine&&m.participants.length?`<p class="academic-muted">Participantes: ${m.participants.map((p:any)=>`${esc(p.name)} (${label(p.status)})`).join(' · ')}</p>`:''}<div class="academic-actions">${m.invitation_status&&m.invitation_status!=='ACCEPTED'?'<button class="btn btn-primary" data-action="accept">Aceptar invitación</button>':''}${m.invitation_status&&m.invitation_status!=='REJECTED'?'<button class="btn btn-outline" data-action="reject">Rechazar</button>':''}${safeUrl(m.url)?`<a class="btn btn-primary" href="${esc(safeUrl(m.url))}" target="_blank" rel="noopener noreferrer">Unirse a reunión</a><button class="btn btn-outline" data-action="copy">Copiar enlace</button><button class="btn btn-outline" data-action="ics">Exportar calendario</button>`:''}${m.mine?'<button class="btn btn-outline" data-action="edit">Editar</button><button class="btn btn-outline" data-action="delete">Eliminar</button>':''}</div></article>`).join(''):'<div class="academic-empty">No hay reuniones en esta vista.</div>';$('meetings').querySelectorAll<HTMLButtonElement>('[data-action]').forEach(b=>b.onclick=async()=>{const m=rows.find(x=>x.id===Number(b.closest<HTMLElement>('[data-meeting]')!.dataset.meeting));try{switch(b.dataset.action){case 'edit':open(m);return;case 'delete':if(!confirm('¿Eliminar reunión?'))return;await data('/api/reuniones/'+m.id,{method:'DELETE'});break;case 'accept':case 'reject':await data('/api/reuniones/'+m.id+'/invitacion',json('PUT',{status:b.dataset.action==='accept'?'ACCEPTED':'REJECTED'}));break;case 'copy':await navigator.clipboard.writeText(m.url);showToast('Enlace copiado');return;case 'ics':ics(m);return;}await load();}catch(e){error(e);}});}
async function load(){try{rows=await data('/api/reuniones');paint();}catch(e){error(e);}}
$('tabs').querySelectorAll<HTMLButtonElement>('button').forEach(b=>b.onclick=()=>{tab=b.dataset.tab!;paint();});$('meeting-search').oninput=paint;$('new-meeting').onclick=()=>open();$('cancel-meeting').onclick=()=>dlg.close();$('platform').onchange=platform;$('student-search').oninput=()=>{clearTimeout(timer);const n=++seq;timer=window.setTimeout(async()=>{try{const q=val('student-search');const results=q.trim().length<2?[]:await data('/api/reuniones/estudiantes?q='+encodeURIComponent(q));if(n!==seq)return;$('student-results').innerHTML=results.filter((s:any)=>!selected.some(x=>x.id===s.id)).map((s:any)=>`<button type="button" data-student="${s.id}">${esc(s.name)} · ${esc(s.carrera||'UTP')}</button>`).join('');$('student-results').querySelectorAll<HTMLButtonElement>('button').forEach(b=>b.onclick=()=>{selected.push(results.find((s:any)=>s.id===Number(b.dataset.student)));students();b.remove();});}catch(e){error(e);}},250);};$('meeting-form').onsubmit=async e=>{e.preventDefault();const b=$('save-meeting') as HTMLButtonElement;b.disabled=true;try{await data('/api/reuniones'+(current?'/'+current.id:''),json(current?'PUT':'POST',{title:val('meeting-title'),course:val('meeting-course'),description:val('meeting-description'),platform:val('platform'),url:val('meeting-url'),starts:new Date(val('starts')).toISOString(),ends:new Date(val('ends')).toISOString(),isPublic:val('privacy')==='public',participants:selected.map(s=>s.id)}));dlg.close();tab='mine';await load();}catch(e){$('meeting-error').textContent=(e as Error).message;}finally{b.disabled=false;}};void load().then(()=>{const id=Number(new URLSearchParams(location.search).get('id'));if(id){const m=rows.find(x=>x.id===id);if(m){tab=m.mine?'mine':m.invitation_status?'invited':'public';paint();document.querySelector(`[data-meeting="${id}"]`)?.scrollIntoView();}}});
</script>
