---
import AppShell from '../../components/AppShell.astro';import Icon from '../../components/Icon.astro';
---
<AppShell active="foros" heading="Nueva publicación" subheading="Comparte una pregunta, una experiencia o una recomendación útil.">
<a href="/foros" class="back-link">← Volver a los foros</a>
<div class="editor-card"><div class="editor-heading"><div class="editor-symbol"><Icon name="edit" size={24}/></div><div><h2>¿Qué quieres compartir?</h2><p>Una buena conversación comienza con una buena idea.</p></div></div><form id="post-form" class="editor-form"><label for="category">Tipo de publicación</label><select id="category" required><option value="PREGUNTAS">Pregunta o duda académica</option><option value="PROFESORES">Recomendación sobre profesores</option><option value="CURSOS">Experiencia o recomendación sobre cursos</option></select><label for="title">Título <span class="field-hint">8 – 150 caracteres</span></label><input id="title" placeholder="Ej.: ¿Qué me recomiendan para aprender Spring Boot?" minlength="8" maxlength="150" required/><label for="content">Descripción <span class="field-hint">15 – 5000 caracteres</span></label><textarea id="content" rows="9" minlength="15" maxlength="5000" required placeholder="Cuéntanos tu duda o experiencia. Incluye detalles que ayuden a los demás a responderte..." ></textarea><div class="editor-bottom"><span id="char-count">0 / 5000 caracteres</span><button type="submit" id="submit-post" class="btn btn-primary"><Icon name="send" size={17}/> Publicar en la comunidad</button></div><p id="post-error" class="form-message" role="alert"></p></form></div>
<Fragment slot="aside"><section class="aside-card"><div class="aside-title"><Icon name="shield" size={18}/> Antes de publicar</div><p class="aside-desc">Tu publicación será visible para otros estudiantes UTP autenticados.</p><div class="rule-box"><b>Convivencia académica</b><p>Evita datos personales de terceros, contenido ofensivo y afirmaciones no verificadas sobre docentes o estudiantes.</p></div></section></Fragment>
</AppShell>
<script>
import {authFetch} from '../../lib/auth';import {responseError} from '../../lib/ui';
const content=document.getElementById('content') as HTMLTextAreaElement;
content.addEventListener('input',()=>document.getElementById('char-count')!.textContent=content.value.length+' / 5000 caracteres');
document.getElementById('post-form')?.addEventListener('submit',async e=>{e.preventDefault();const btn=document.getElementById('submit-post') as HTMLButtonElement;const msg=document.getElementById('post-error')!;btn.disabled=true;btn.textContent='Publicando...';msg.textContent='';try{const r=await authFetch('/api/foros',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({categoria:(document.getElementById('category') as HTMLSelectElement).value,titulo:(document.getElementById('title') as HTMLInputElement).value.trim(),contenido:content.value.trim()})});if(!r?.ok)throw new Error(r?await responseError(r):'Inicia sesión nuevamente.');const p=await r.json();location.href='/foro?id='+p.id;}catch(err){msg.textContent=err instanceof Error?err.message:'No pudimos publicar tu mensaje.';btn.disabled=false;btn.textContent='Publicar en la comunidad →';}});
</script>
