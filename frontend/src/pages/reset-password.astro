---
import '../styles/auth.css';
---

<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Nueva contraseña</title>
  </head>

  <body>
    <main>
      <h1>UTP Community</h1>
      <h2>Nueva contraseña</h2>

      <form id="resetForm">
        <div>
          <label for="password"> Nueva contraseña </label>

          <input id="password" type="password" minlength="8" required />
        </div>

        <button id="resetButton" type="submit"> Cambiar contraseña </button>
      </form>

      <p id="mensaje"></p>

      <nav>
        <a href="/login">Ir al login</a>
      </nav>
    </main>

    <script>
      import { apiFetch } from '../lib/api';

      const form = document.getElementById('resetForm');

      const password = document.getElementById('password') as HTMLInputElement;

      const mensaje = document.getElementById('mensaje') as HTMLParagraphElement;

      const boton = document.getElementById('resetButton') as HTMLButtonElement;

      const params = new URLSearchParams(window.location.search);

      const token = params.get('token');

      form?.addEventListener('submit', async (event) => {
        event.preventDefault();

        if (!token) {
          mensaje.textContent = 'Token no encontrado.';
          return;
        }

        boton.disabled = true;
        boton.classList.add('loading');
        boton.classList.remove('completed');
        boton.textContent = 'Cambiando...';

        mensaje.textContent = '';

        try {
          const response = await apiFetch('/api/auth/reset-password', {
            method: 'POST',

            headers: {
              'Content-Type': 'application/json',
            },

            body: JSON.stringify({
              token,
              nuevaPassword: password.value,
            }),
          });

          const data = await response.json();

          mensaje.textContent = data.mensaje ?? data.message ?? 'Proceso finalizado.';

          if (response.ok) {
            boton.classList.remove('loading');
            boton.classList.add('completed');
            boton.textContent = 'Contraseña cambiada';
          } else {
            boton.disabled = false;
            boton.classList.remove('loading');
            boton.textContent = 'Cambiar contraseña';
          }
        } catch {
          mensaje.textContent = 'No se pudo conectar con el servidor.';

          boton.disabled = false;
          boton.classList.remove('loading');
          boton.textContent = 'Cambiar contraseña';
        }
      });
    </script>
  </body>
</html>
